{
  "name": "cleangenius-ai",
  "version": "1.0.0",
  "description": "AI-powered Windows disk cleanup tool",
  "author": {
    "name": "CleanGenius Team",
    "email": "support@cleangenius.ai"
  },
  "license": "MIT",
  "main": "src/main/index.js",
  "homepage": "https://github.com/cleangenius/cleangenius-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/cleangenius/cleangenius-ai.git"
  },
  "scripts": {
    "prepare-build": "node scripts/prepare-build.js",
    "generate-icon": "node scripts/generate-icon.js",
    "prebuild": "npm run prepare-build && npm run generate-icon",
    "dev": "node scripts/dev.js",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:python": "python src/backend/main.py",
    "start": "electron .",
    "test": "pytest tests/backend && jest tests/frontend",
    "test:python": "pytest tests/backend",
    "test:js": "jest tests/frontend",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.1.2",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.1.3",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "png-to-ico": "^2.1.8",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.cleangenius.ai",
    "productName": "CleanGenius AI",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "config/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "resources/icons/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "publisherName": "CleanGenius Team"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh",
      "license": "LICENSE"
    },
    "extraResources": [
      {
        "from": "dist-backend/cleangenius-backend.exe",
        "to": "backend/cleangenius-backend.exe"
      },
      {
        "from": "src/backend",
        "to": "backend-src",
        "filter": ["**/*"]
      },
      {
        "from": "config",
        "to": "config",
        "filter": ["**/*"]
      }
    ]
  }
}
