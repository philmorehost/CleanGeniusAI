{
  "name": "cleangenius-ai",
  "version": "1.0.0",
  "description": "AI-Powered Windows Disk Cleanup Utility",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:python": "python src/backend/main.py",
    "start": "electron .",
    "test": "pytest tests/backend && jest tests/frontend",
    "test:python": "pytest tests/backend",
    "test:js": "jest tests/frontend",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "electron-log": "^5.1.2",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.cleangenius.ai",
    "productName": "CleanGenius AI",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "extraResources": [
        {
          "from": "src/backend",
          "to": "backend"
        },
        {
          "from": "config",
          "to": "config"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE",
      "include": "build/installer.nsh"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "config/**/*",
      "build/**/*",
      "package.json"
    ]
  }
}
