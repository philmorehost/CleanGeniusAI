<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="CleanPro" Manufacturer="CleanPro Open Source Project" Version="1.0.0.0" UpgradeCode="a1b2c3d4-e5f6-7890-abcd-ef1234567890">
    <MajorUpgrade DowngradeErrorMessage="A newer version of CleanPro is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CleanPro" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- Component files populated during publish/build -->
    </ComponentGroup>

    <Feature Id="MainFeature" Title="CleanPro" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>
</Wix>
